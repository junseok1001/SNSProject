<?xml version="1.0" encoding="utf-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sourjelly.snsproject.user.repository.UserRepository">
    <insert id="insertUser" parameterType="map">
        INSERT INTO
            `user`
        (
          `login_id`
        , `password`
        , `phone_number`
        , `email`
        )
            VALUE
            (
            #{loginId}
            , #{password}
            , #{phoneNumber}
            , #{email}
            )

    </insert>

    <select id="isDupulicateId" parameterType="string"
    resultType="int">
            SELECT
                COUNT(*)
            FROM
                `user`
            WHERE
                `login_id`= #{loginId}
    </select>

</mapper>